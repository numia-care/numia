# ============================================================================
# Numia — переменные окружения (шаблон)
# ============================================================================
# Скопируй в .env.local и заполни реальными значениями. .env* в .gitignore —
# реальные значения НИКОГДА не коммитятся.
#
# Для Vercel те же значения добавляются в Project Settings → Environment
# Variables (Production и Preview).
#
# NEXT_PUBLIC_* попадают в клиентский бандл — здесь только публичные значения.

# ── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → API. Проект должен быть в регионе EU (Frankfurt/Ireland).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable (anon) key — публичный по дизайну, данные защищает RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ── Web Push (VAPID) ────────────────────────────────────────────────────────
# Пара генерится один раз: pnpm dlx web-push generate-vapid-keys
# Публичный — в браузер для pushManager.subscribe.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=B...
# Приватный — ТОЛЬКО сервер (отправка пушей). Никогда не префиксовать NEXT_PUBLIC_.
VAPID_PRIVATE_KEY=...

# ── Edge Functions (задаются в Supabase, НЕ здесь) ──────────────────────────
# Эти переменные живут в Supabase Dashboard → Edge Functions → Secrets,
# перечислены для полноты картины (см. supabase/functions/DEPLOY.md):
#   VAPID_PUBLIC_KEY   — то же значение, что NEXT_PUBLIC_VAPID_PUBLIC_KEY
#   VAPID_PRIVATE_KEY  — приватный ключ той же пары
#   VAPID_SUBJECT      — mailto:<контактный email> для push-сервисов
#   CRON_SECRET        — гейт для cron-вызовов (тот же, что в Vault, см.
#                        supabase/migrations/20260612130000_etap1b_cron_jobs.sql)
# SUPABASE_URL и SUPABASE_SERVICE_ROLE_KEY Supabase подставляет сам.
