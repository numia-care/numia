# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# шаблон без секретов — единственный env-файл, который должен быть в git
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code локальная память между сессиями (не должна попадать в git)
.claude/

# Личные документы, случайно сохранённые в папку проекта (резюме, сканы,
# договоры, выгрузки). Правило намеренно широкое: файл, попавший в коммит,
# остаётся в истории git НАВСЕГДА — вычистить его потом можно только
# переписыванием истории. Дважды ловили такое в app/ (резюме,
# шаблоны документов), оба раза до коммита — везение, не система.
# Если документ реально нужен в репозитории — добавлять осознанно: git add -f.
*.pdf
*.doc
*.docx
*.xls
*.xlsx
*.zip
*.rar
*.7z

# Рабочие дизайн-референсы и исходные SVG от дизайнера — в опенсорс не нужны,
# файлы остаются на диске. PWA-иконки живут отдельно в /public/icons и в git
# остаются. Те же правила есть в design-kai — держим их одинаковыми, чтобы
# ветки не расходились и `git add -A` не утащил лишнее.
скрины дизайна/
/icons/
