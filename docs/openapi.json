{
  "openapi": "3.1.0",
  "info": {
    "title": "Numia BFF",
    "version": "1.0.0",
    "description": "Contract between the iOS app and the BFF. Versioning rules, the sign-in model and the encryption boundary are described in docs/api-v1.md. Fields come from the zod schemas in lib/api/schemas.ts."
  },
  "servers": [
    {
      "url": "/api/v1",
      "description": "Relative to the BFF host"
    }
  ],
  "tags": [
    {
      "name": "system",
      "description": "Service endpoints"
    },
    {
      "name": "auth",
      "description": "Sign-in with an emailed code"
    },
    {
      "name": "profile",
      "description": "User profile"
    },
    {
      "name": "e2e",
      "description": "E2E key material. The server sees no secrets."
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Liveness check",
        "operationId": "getHealth",
        "security": [],
        "responses": {
          "200": {
            "description": "The service is alive.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "This specification",
        "operationId": "getOpenApi",
        "security": [],
        "responses": {
          "200": {
            "description": "OpenAPI 3.1 document.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/auth/otp": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Send a code by email",
        "description": "For a new address an account is created along the way. Always responds 204, whether the account exists or not; otherwise the response would reveal who uses the app. A 429 shortly after the previous request means the code has already been sent.",
        "operationId": "sendOtp",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OtpRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Code sent (or the address does not exist; we do not distinguish)."
          },
          "400": {
            "$ref": "#/components/responses/InvalidInput"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        }
      }
    },
    "/auth/verify": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Exchange the code for tokens",
        "operationId": "verifyOtp",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tokens.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "400": {
            "description": "invalid_input — the body failed validation; invalid_code — the code is wrong or expired (we do not distinguish).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "New token pair",
        "description": "Every exchange issues a new refresh_token — store it. There is one refresh for the whole app: parallel requests that got 401 wait for its result.",
        "operationId": "refreshTokens",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "New tokens.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidInput"
          },
          "401": {
            "description": "The session has ended — sign in again.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Sign out on this device",
        "description": "Always 204, including for an invalid token. The access token lives until it expires, so the client erases both tokens at once.",
        "operationId": "logout",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "204": {
            "description": "Signed out."
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        }
      }
    },
    "/me": {
      "get": {
        "tags": [
          "profile"
        ],
        "summary": "Profile",
        "operationId": "getProfile",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Profile of the current user.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        }
      },
      "patch": {
        "tags": [
          "profile"
        ],
        "summary": "Update profile",
        "operationId": "updateProfile",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProfilePatchRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated profile.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidInput"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        }
      },
      "delete": {
        "tags": [
          "profile"
        ],
        "summary": "Delete account",
        "description": "Deletes the account, all data and files, and signs out all devices. Irreversible. There is no repeated code check. Idempotent: after a failure, a retry cleans up the rest. If the 204 response was lost, a retry returns 401 — the account is already gone; the client erases the tokens and local data the same way as after 204.",
        "operationId": "deleteAccount",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "204": {
            "description": "Account deleted."
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          },
          "503": {
            "description": "Storage unavailable. The account is not deleted, some files may already be deleted — retry later.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/e2e/recovery": {
      "get": {
        "tags": [
          "e2e"
        ],
        "summary": "Recovery anchor",
        "description": "404 — there is no anchor, a new DEK may be created. Any read failure is 500 or 503, never 404: on a false 404 the client would generate a new DEK and lose data.",
        "operationId": "getRecoveryAnchor",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Anchor.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecoveryAnchorResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "404": {
            "description": "No anchor.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        }
      },
      "put": {
        "tags": [
          "e2e"
        ],
        "summary": "Create or change the recovery anchor",
        "description": "Conditional write. expected_anchor_version: 0 — create only if there is no anchor; N — replace only if the current version is N. The check and the write are atomic in the DB. Repeating the same body is safe: if the anchor is already exactly the same, the response is 200 with the current version.",
        "operationId": "putRecoveryAnchor",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecoveryAnchorPutRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Written. anchor_version is the new version.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecoveryAnchorResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidInput"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "409": {
            "description": "Version mismatch: the anchor was created or changed from another device in the meantime. Nothing was written. Re-read with GET and go to recovery by phrase.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiErrorCode": {
        "type": "string",
        "x-enum-values": [
          "invalid_input",
          "invalid_code",
          "unauthenticated",
          "forbidden",
          "not_found",
          "conflict",
          "unprocessable",
          "rate_limited",
          "internal",
          "service_unavailable"
        ],
        "description": "Known values: invalid_input, invalid_code, unauthenticated, forbidden, not_found, conflict, unprocessable, rate_limited, internal, service_unavailable. The list may grow within v1 — the client must survive an unknown value."
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "$ref": "#/components/schemas/ApiErrorCode"
              },
              "message": {
                "description": "For logs and debugging. Do not show to the user.",
                "type": "string"
              },
              "field": {
                "description": "The field that failed validation.",
                "type": "string"
              }
            },
            "required": [
              "code"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          },
          "api": {
            "type": "string",
            "const": "v1"
          },
          "version": {
            "type": "string",
            "description": "Build revision of the image."
          }
        },
        "required": [
          "status",
          "api",
          "version"
        ]
      },
      "OtpRequest": {
        "type": "object",
        "properties": {
          "email": {
            "format": "email",
            "maxLength": 320,
            "type": "string"
          }
        },
        "required": [
          "email"
        ],
        "additionalProperties": false
      },
      "VerifyRequest": {
        "type": "object",
        "properties": {
          "email": {
            "format": "email",
            "maxLength": 320,
            "type": "string"
          },
          "code": {
            "type": "string",
            "pattern": "^\\d{6}$",
            "description": "6 digits from the email."
          }
        },
        "required": [
          "email",
          "code"
        ],
        "additionalProperties": false
      },
      "RefreshRequest": {
        "type": "object",
        "properties": {
          "refresh_token": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "required": [
          "refresh_token"
        ],
        "additionalProperties": false
      },
      "TokenResponse": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string",
            "description": "Opaque string. The client does not decode it."
          },
          "refresh_token": {
            "type": "string",
            "description": "Opaque string. Store the new one after every exchange."
          },
          "expires_in": {
            "type": "integer",
            "description": "Lifetime of access_token in seconds."
          },
          "token_type": {
            "type": "string",
            "const": "bearer"
          }
        },
        "required": [
          "access_token",
          "refresh_token",
          "expires_in",
          "token_type"
        ]
      },
      "ProfileResponse": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "string",
            "format": "uuid"
          },
          "timezone": {
            "type": "string",
            "description": "IANA name. In the clear: the server uses it to compute slots and send reminders."
          },
          "profile_ciphertext": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "E2E blob with the name and form of address, base64(iv ‖ ct). The server does not read it."
          },
          "e2e": {
            "type": "object",
            "properties": {
              "has_recovery_anchor": {
                "type": "boolean",
                "description": "Whether the server holds a wrap of the key under the recovery phrase."
              }
            },
            "required": [
              "has_recovery_anchor"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601, UTC, with Z, no fractional seconds: 2026-09-15T11:09:46Z."
          }
        },
        "required": [
          "user_id",
          "timezone",
          "profile_ciphertext",
          "e2e",
          "created_at"
        ]
      },
      "ProfilePatchRequest": {
        "type": "object",
        "properties": {
          "timezone": {
            "type": "string",
            "description": "IANA time zone name, e.g. Europe/Madrid."
          },
          "profile_ciphertext": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 8192
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false
      },
      "RecoveryAnchorResponse": {
        "type": "object",
        "properties": {
          "dek_wrapped_recovery": {
            "type": "string",
            "description": "base64(iv ‖ ciphertext ‖ tag): the DEK wrapped with the key derived from the recovery phrase."
          },
          "recovery_salt": {
            "type": "string",
            "description": "base64, the PBKDF2 salt for deriving the key from the phrase."
          },
          "recovery_kdf_iterations": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "PBKDF2 iterations. null means a legacy anchor with 210 000. Take it from the response, not from a constant."
          },
          "anchor_version": {
            "type": "integer",
            "minimum": 1,
            "description": "Current anchor version. Passed as expected_anchor_version when changing the phrase."
          }
        },
        "required": [
          "dek_wrapped_recovery",
          "recovery_salt",
          "recovery_kdf_iterations",
          "anchor_version"
        ]
      },
      "RecoveryAnchorPutRequest": {
        "type": "object",
        "properties": {
          "dek_wrapped_recovery": {
            "type": "string",
            "minLength": 80,
            "maxLength": 80,
            "description": "base64(iv 12 ‖ ciphertext 32 ‖ tag 16) — exactly 60 bytes."
          },
          "recovery_salt": {
            "type": "string",
            "minLength": 24,
            "maxLength": 24,
            "description": "base64, exactly 16 bytes."
          },
          "recovery_kdf_iterations": {
            "type": "integer",
            "minimum": 600000,
            "maximum": 10000000
          },
          "expected_anchor_version": {
            "type": "integer",
            "minimum": 0,
            "description": "0 — create only if there is no anchor. N — replace only if the current version is N."
          }
        },
        "required": [
          "dek_wrapped_recovery",
          "recovery_salt",
          "recovery_kdf_iterations",
          "expected_anchor_version"
        ],
        "additionalProperties": false
      }
    },
    "responses": {
      "InvalidInput": {
        "description": "The body failed validation. `field` points to the field.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Unauthenticated": {
        "description": "No token, or it expired or was not accepted. Call /auth/refresh and retry; if that also returns 401, sign in again.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "RateLimited": {
        "description": "Too many requests. Wait as many seconds as Retry-After says.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "headers": {
          "Retry-After": {
            "description": "Seconds until the next attempt.",
            "schema": {
              "type": "integer"
            }
          }
        }
      },
      "ServiceUnavailable": {
        "description": "The BFF is alive but could not reach the storage. The token may still be valid, so do NOT reset the session; retry with increasing delay.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "NotFound": {
        "description": "No such record.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Internal": {
        "description": "Server error. It does not mean the record does not exist.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "access_token from /auth/verify or /auth/refresh. Opaque."
      }
    }
  }
}
